{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build vscode extension",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build", "-w", "apps/vscode"],
      "presentation": {
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "watch vscode extension",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch", "-w", "apps/vscode"],
      "isBackground": true,
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": ["$tsc-watch"]
    },
    {
      "label": "build all",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "test",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "presentation": {
        "reveal": "always"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
